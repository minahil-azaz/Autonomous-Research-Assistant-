# ── Copy this file to .env and fill in your keys ──────────────────────────────

# OpenAI — used by GPT-4o for reasoning, reflection, and synthesis
OPENAI_API_KEY=sk-...

# Tavily — AI-native web search (get free key at tavily.com)
TAVILY_API_KEY=tvly-...

# ChromaDB persist directory (relative to backend/)
CHROMA_DB_DIR=./chroma_db

# Optional: set to "development" or "production"
APP_ENV=development
